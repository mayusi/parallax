{
 "name": "V7Good",
 "about": "selftest control: the same pieces done right - flex inside a list, a box tall enough at Largest, readable text, a meter that reads",
 "theme": { "bg": "#101218", "text": "#f0f2f5", "dim": "#1a1c22" },
 "root": { "type": "panel", "name": "Root", "color": "bg", "children": [
  { "type": "panel", "name": "Row", "size": [600, 60], "layout": { "dir": "horizontal", "flex": "between", "lineAlign": "center" }, "children": [
   { "type": "panel", "name": "A", "size": [80, 40], "flex": "grow" },
   { "type": "panel", "name": "B", "size": [80, 40], "flex": { "grow": 2, "shrink": 1 } }
  ] },
  { "type": "label", "name": "Hp", "text": "HP", "textSize": 20, "size": [200, 40], "preferredText": true },
  { "type": "bar", "name": "Meter", "size": [300, 12], "color": "bg", "fill": "text", "value": 0.5 }
 ] }
}

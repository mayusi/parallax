   { "type": "hitmarker", "name": "Hit", "size": 12 }
  ] },
  { "type": "label", "name": "Title", "text": "STAGE CLEAR", "textSize": 40, "size": [400, 60], "pos": [40, 320],
    "fx": [{ "kind": "shimmer", "period": 0.3 }, { "kind": "split", "every": 0.3, "dur": 0.03 }] },
  { "type": "button", "name": "Go", "text": "GO", "size": [160, 56], "pos": [40, 400], "motion": { "loop": { "type": "glint", "speed": 12 } } }
 ] }

-- guard.spec.luau — Guard rejects hostile client input; RateLimit enforces bursts + refill.
local frk = require("../frk")
local test, check = frk.test, frk.check

local Guard = require("../../../src/kit/Guard")
local RateLimit = require("../../../src/kit/RateLimit")

return function()
	test.suite("Guard.number", function()
		test.case("accepts in-range numbers", function()
			local ok, v = Guard.number(5, 0, 10)
			check.is_true(ok)
			check.equal(v, 5)
		end)
		test.case("rejects NaN, inf, wrong types, out of range", function()
			for _, bad in { 0 / 0, math.huge, -math.huge, "5", nil, {}, 11, -1 } do
				check.is_false((Guard.number(bad, 0, 10)))
			end
		end)
	end)

	test.suite("Guard.integer / string / oneOf / boolean", function()
		test.case("integer rejects fractions", function()
			check.is_false((Guard.integer(2.5, 0, 10)))
			check.is_true((Guard.integer(2, 0, 10)))
		end)
		test.case("string enforces 1..maxLen", function()
			check.is_false((Guard.string("", 5)))
			check.is_false((Guard.string("toolong", 5)))
			check.is_false((Guard.string(42, 5)))
			check.is_true((Guard.string("ok", 5)))
		end)
		test.case("oneOf only allows listed values", function()
			check.is_true((Guard.oneOf("fire", { "fire", "ice" })))
			check.is_false((Guard.oneOf("admin", { "fire", "ice" })))
		end)
		test.case("boolean is strict", function()
			check.is_false((Guard.boolean(1)))
			check.is_true((Guard.boolean(false)))
		end)
	end)

	test.suite("Guard.withinRange", function()
		test.case("inside and outside", function()
			check.is_true(Guard.withinRange({ X = 0, Y = 0, Z = 0 }, { X = 3, Y = 4, Z = 0 }, 5))
			check.is_false(Guard.withinRange({ X = 0, Y = 0, Z = 0 }, { X = 3, Y = 4, Z = 0.1 }, 5))
		end)
	end)

	test.suite("RateLimit", function()
		test.case("allows the burst then blocks", function()
			local limit = RateLimit.new(3, 1)
			check.is_true(limit:take("p", 0))
			check.is_true(limit:take("p", 0))
			check.is_true(limit:take("p", 0))
			check.is_false(limit:take("p", 0))
		end)
		test.case("refills over time and caps at capacity", function()
			local limit = RateLimit.new(2, 1)
			limit:take("p", 0)
			limit:take("p", 0)
			check.is_false(limit:take("p", 0.5))
			check.is_true(limit:take("p", 1.6))
			limit:take("p", 100) -- long idle: back to full (2), not 100
			check.is_true(limit:take("p", 100))
			check.is_false(limit:take("p", 100))
		end)
		test.case("keys are independent and forget resets", function()
			local limit = RateLimit.new(1, 0)
			check.is_true(limit:take("a", 0))
			check.is_true(limit:take("b", 0))
			check.is_false(limit:take("a", 0))
			limit:forget("a")
			check.is_true(limit:take("a", 0))
		end)
	end)
end

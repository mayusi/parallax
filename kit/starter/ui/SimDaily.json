     { "type": "label", "name": "Hint", "text": "Come back tomorrow for DAY 5 — streaks reset after 48 h", "role": "body", "textSize": 24, "textColor": "textDark", "size": ["100%-80", 32], "pos": ["50%", "100%-26"], "anchor": "bottom", "motion": { "enter": { "type": "fade", "delay": 0.5 } } }
    ]

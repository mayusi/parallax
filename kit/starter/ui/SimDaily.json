{
 "name": "SimDaily",
 "identity": "sim",
 "quality": "hero",
 "focus": "Daily.Card.Title.Txt",
 "kind": "menu",
 "enabled": false,
 "insets": "none",
 "scale": { "phone": 0.5, "tablet": 0.72 },
 "root": {

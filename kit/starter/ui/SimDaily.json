         ] },
       { "type": "panel", "name": "D6", "plate": "bubble_panel", "shadow": true, "size": [150, 190], "motion": { "enter": "bounce" },
         "children": [
          { "type": "label", "name": "Day", "text": "DAY 6", "role": "heading", "textSize": 20, "textColor": "textDark", "size": ["100%", 26], "pos": [0, 10] },
          { "type": "image", "name": "Icon", "image": "art:sim/icon_gem", "fit": "fit", "size": [90, 90], "pos": ["50%", 38], "anchor": "top" },

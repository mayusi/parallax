      "type": "panel", "name": "Title", "plate": "banner_accent", "shadow": true, "size": [540, 92], "pos": ["50%", -36], "anchor": "top", "z": 3,
      "motion": { "enter": { "type": "drop", "delay": 0.15, "duration": 0.5, "ease": "back" } },
      "children": [
       { "type": "image", "name": "Icon", "image": "art:sim/icon_gift", "fit": "fit", "size": [84, 84], "pos": [10, "50%-6"], "anchor": "left", "z": 4, "motion": { "loop": { "type": "wobble", "speed": 0.6 } } },

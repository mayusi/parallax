         ] },
       { "type": "panel", "name": "D4", "plate": "bubble_accent", "shadow": true, "size": [180, 226], "motion": { "enter": { "type": "bounce", "duration": 0.7 }, "loop": { "type": "breathe", "speed": 1.2 } },

{
  "name": "MainMenu",
  "enabled": false,
  "skin": "clean",
  "root": {
    "type": "panel",
    "name": "Backdrop",
    "size": ["100%", "100%"],
    "color": "bg",
    "transparency": 0.3,
    "children": [
      { "type": "vignette", "name": "Vignette", "alpha": 0.2 },
      {
        "type": "panel",
        "name": "Card",
        "style": "card",
        "radius": "l",
        "size": [380, 360],
        "slot": "center",
        "padding": 24,
        "strokeGradient": ["accent", "accent2"],
        "motion": { "enter": "pop" },
        "layout": { "dir": "vertical", "gap": 12, "align": "center" },
        "children": [
          { "type": "label", "name": "Title", "text": "STRIKE OPS", "role": "title", "textGradient": ["text", "accent"], "size": ["100%", 44] },
          { "type": "label", "name": "Subtitle", "text": "Field command uplink ready", "role": "hint", "size": ["100%", 22] },
          { "type": "button", "name": "Play", "style": "primary", "text": "DEPLOY", "textSize": 20, "size": ["100%", 52] },
          { "type": "button", "name": "Loadout", "style": "secondary", "text": "LOADOUT", "size": ["100%", 48] },
          { "type": "button", "name": "Settings", "style": "secondary", "text": "SETTINGS", "size": ["100%", 48] }
        ]
      }
    ]
  }
}
